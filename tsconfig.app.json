{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*", "vite.config.ts", "index.html"],
  "exclude": ["node_modules", "dist", "api"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}